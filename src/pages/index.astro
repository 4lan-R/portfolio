---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Portfolio Redesign',
    description: 'A modern portfolio website built with Astro and accessible components.',
    link: '#projects',
  },
  {
    title: 'E-commerce Landing Page',
    description: 'Clean product showcase with responsive layout and fast performance.',
    link: '#projects',
  },
  {
    title: 'Blog Theme',
    description: 'A custom blog theme focused on readability, speed, and SEO.',
    link: '#projects',
  },
];

const skills = ['Astro', 'HTML', 'CSS', 'JavaScript', 'Responsive Design', 'UI/UX', 'Git', 'SEO'];
---
<BaseLayout title="Your Name — Portfolio" description="A clean Astro portfolio website.">
  <section id="home" class="hero container">
    <p>Hi, I’m</p>
    <h1>YOUR NAME</h1>
    <p>
      I build fast, modern websites with clean design and thoughtful user experience.
      I specialize in Astro, responsive interfaces, and performance-first development.
    </p>
    <a class="button-primary" href="#contact">Work with me</a>
  </section>

  <section id="about" class="section container">
    <span class="section-title">About</span>
    <div class="grid grid-2">
      <div>
        <h2>Experienced Web Creator</h2>
        <p>
          I help startups and independent brands bring digital ideas to life. My focus is on fast loading
          websites, accessible interfaces, and polished visual design.
        </p>
      </div>
      <div>
        <p>
          I work across the full web stack: static sites, interactive UI components, and modern
          front-end workflows. I enjoy transforming product goals into intuitive online experiences.
        </p>
      </div>
    </div>
  </section>

  <section id="projects" class="section container">
    <span class="section-title">Projects</span>
    <div class="grid grid-2">
      {projects.map((project) => (
        <article class="card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <a href={project.link}>View details →</a>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="section container">
    <span class="section-title">Skills</span>
    <div class="skill-list">
      {skills.map((skill) => (
        <span class="skill-pill">{skill}</span>
      ))}
    </div>
  </section>

  <section id="contact" class="section container">
    <span class="section-title">Contact</span>
    <div class="cta-grid">
      <div class="cta-card">
        <h3>Let’s build something together</h3>
        <p>
          I’m available for freelance work, contract roles, and collaborative projects. Send a message
          and let’s get started.
        </p>
        <a class="button-primary" href="mailto:hello@example.com">Email me</a>
      </div>
    </div>
  </section>
</BaseLayout>
