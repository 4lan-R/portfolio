---
import { experiences } from "../data/experience";
---

<section id="experience" class="section-shell">
  <div class="section-label">Experience</div>
  <h2 class="section-title">A trajectory of applied AI, systems, and product delivery.</h2>

  <div class="mt-10 space-y-8">
    {
      experiences.map((experience) => (
        <div class="glass-card rounded-[1.6rem] p-6 md:p-8">
          <h3 class="text-2xl font-semibold">{experience.company}</h3>
          <p class="mt-2 text-sm text-slate-400">{experience.location}</p>

          <div class="mt-8 space-y-6 border-l border-cyan-400/20 pl-6">
            {experience.roles.map((role) => (
              <div class="timeline-card">
                <div class="mb-3 flex flex-wrap items-center gap-3">
                  <span class="text-lg font-semibold">{role.role}</span>
                  <span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs uppercase tracking-[0.2em] text-cyan-300">
                    {role.type}
                  </span>
                </div>
                <p class="text-sm text-slate-400">{role.duration}</p>
                <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-300">
                  {role.points.map((point) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-cyan-300"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>