---
import { contact } from "../data/contact";
---

<section id="contact" class="mx-auto max-w-4xl px-6 py-24 text-center">
  <div class="brutalist-card brutalist-card--accent p-8 md:p-10">
    <h2 class="mb-6 text-4xl font-black uppercase tracking-tight">
      Contact
    </h2>

    <p class="mb-8 text-lg text-black/80">
      Whether it's building AI-powered products, designing agent-based systems, or
      delivering robust Python backends, I bring strong ownership, problem-solving,
      and a passion for innovation. Let's connect and collaborate!
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href={`mailto:${contact.email}`} class="brutalist-btn bg-[#ff6b35] px-5 py-3 text-black" aria-label="Email">
        Email
      </a>
      <a href={`tel:${contact.mobile}`} class="brutalist-btn bg-white px-5 py-3 text-black" aria-label="Phone">
        Call
      </a>
      <a href="https://www.linkedin.com/in/alan-remanan" target="_blank" class="brutalist-btn bg-[#3b82f6] px-5 py-3 text-white" aria-label="LinkedIn">
        LinkedIn
      </a>
      <a href="https://www.instagram.com/4lan____" target="_blank" class="brutalist-btn bg-[#111111] px-5 py-3 text-white" aria-label="Instagram">
        Instagram
      </a>
    </div>
  </div>
</section>