---
import { skills } from "../data/skills";
---

<section id="skills" class="max-w-5xl mx-auto px-6 py-24">

  <h2 class="text-4xl font-bold mb-10">
    Skills
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

    {
      skills.map((skill) => (
        <div
          class="border border-gray-800 rounded-xl p-4 transition hover:border-gray-600 hover:-translate-y-1"
        >
          {skill}
        </div>
      ))
    }

  </div>

</section>