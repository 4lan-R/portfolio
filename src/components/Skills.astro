---
import { skills } from "../data/skills";
import { Icon } from "astro-icon/components";
---

<section id="skills" class="section-shell">
  <div class="section-label">Skills</div>
  <h2 class="section-title">Core systems, APIs, and AI infrastructure.</h2>

  <div class="mt-10 space-y-8">
    {
      skills.map((group) => (
        <div>
          <h3 class="mb-4 text-lg font-semibold text-slate-300">{group.category}</h3>
          <div class="flex flex-wrap gap-3">
            {group.items.map((skill) => (
              <div class="skill-pill glass-card">
                <Icon name={skill.icon} class="h-5 w-5 text-cyan-300" />
                <span>{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>