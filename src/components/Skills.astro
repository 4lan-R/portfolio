---
import { skills } from "../data/skills";
import { Icon } from "astro-icon/components";
---

<section id="skills" class="mx-auto max-w-6xl px-6 py-24">
  <h2 class="mb-12 text-4xl font-black uppercase tracking-tight">
    Skills
  </h2>

  <div class="space-y-10">
    {
      skills.map((group) => (
        <div>
          <h3 class="mb-5 text-xl font-black uppercase tracking-[0.2em] text-muted">
            {group.category}
          </h3>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              group.items.map((skill) => (
                <div class="card flex items-center gap-3 p-4">
                  <Icon name={skill.icon} class="h-6 w-6" />
                  <span class="font-semibold">{skill.name}</span>
                </div>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>
</section>