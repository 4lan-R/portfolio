---
import { projects } from "../data/projects";
---

<section id="projects" class="max-w-5xl mx-auto px-6 py-32">

  <h2 class="text-4xl font-bold mb-12">
    Projects
  </h2>

  <div class="grid md:grid-cols-2 gap-8">

    {
      projects.map((project) => (
        <div
          class="border border-gray-800 rounded-2xl p-6 transition hover:-translate-y-1 hover:border-gray-600"
        >
          <h3 class="text-2xl font-semibold mb-4">
            {project.title}
          </h3>

          <p class="text-gray-400 mb-6">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-2 mb-6">
            {
              project.tech.map((tech) => (
                <span
                  class="border border-gray-700 px-3 py-1 rounded-lg text-sm"
                >
                  {tech}
                </span>
              ))
            }
          </div>

          <a
            href={project.github}
            target="_blank"
            class="text-white underline"
          >
            View Project
          </a>
        </div>
      ))
    }

  </div>

</section>