---
import { projects } from "../data/projects";
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-24">
  <h2 class="mb-12 text-4xl font-black uppercase tracking-tight">
    Projects
  </h2>

  <div class="grid gap-8 md:grid-cols-2">
    {
      projects.map((project) => (
        <div class="brutalist-card bg-white p-6">
          <h3 class="mb-4 text-2xl font-black uppercase">
            {project.title}
          </h3>

          <p class="mb-6 text-black/80">{project.description}</p>

          <div class="mb-6 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="border-2 border-black bg-[#f9e34b] px-3 py-1 text-sm font-semibold uppercase">
                {tech}
              </span>
            ))}
          </div>

          <a href={project.github} target="_blank" class="brutalist-link text-black">
            View Project
          </a>
        </div>
      ))
    }
  </div>
</section>