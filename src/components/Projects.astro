---
import { projects } from "../data/projects";
---

<section id="projects" class="section-shell">
  <div class="section-label">Projects</div>
  <h2 class="section-title">Selected builds that balance intelligence, speed, and clarity.</h2>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      projects.map((project) => (
        <article class="project-card glass-card">
          <h3>{project.title}</h3>
          <p class="text-sm leading-7 text-slate-400">{project.description}</p>

          <div class="mt-5 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="project-badge">{tech}</span>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href={project.github} target="_blank" class="hero-cta">View on GitHub</a>
          </div>
        </article>
      ))
    }
  </div>
</section>