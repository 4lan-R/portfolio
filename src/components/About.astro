---
import { about } from "../data/about";
---

<section id="about" class="section-shell">
  <div class="section-label">About</div>
  <h2 class="section-title">Crafting resilient systems with a design-forward mindset.</h2>
  <p class="section-copy whitespace-pre-line">{about.description}</p>

  <div class="mt-10 grid gap-4 md:grid-cols-3">
    <div class="stat-card glass-card">
      <div class="stat-value">6+</div>
      <div class="text-sm text-slate-400">Years of building software</div>
    </div>
    <div class="stat-card glass-card">
      <div class="stat-value">20+</div>
      <div class="text-sm text-slate-400">Production-ready AI features shipped</div>
    </div>
    <div class="stat-card glass-card">
      <div class="stat-value">100%</div>
      <div class="text-sm text-slate-400">Focus on reliability and performance</div>
    </div>
  </div>
</section>