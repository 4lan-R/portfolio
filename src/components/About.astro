---
import { about } from "../data/about";
---

<section id="about" class="mx-auto max-w-5xl px-6 py-24">
  <div class="brutalist-card brutalist-card--accent p-8 md:p-10">
    <h2 class="mb-6 text-4xl font-black uppercase tracking-tight">
      {about.title}
    </h2>

    <p class="whitespace-pre-line text-lg leading-8 text-black/80">
      {about.description}
    </p>
  </div>
</section>