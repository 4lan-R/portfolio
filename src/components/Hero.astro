---
import { hero } from "../data/hero";
---

<section id="home" class="flex min-h-screen items-center justify-center px-6 py-24">
  <div class="w-full max-w-5xl border-4 border-black bg-[#fff8dc] p-8 shadow-[10px_10px_0_#111] md:p-12">
    <p class="mb-4 inline-block border-2 border-black bg-[#ff6b35] px-3 py-1 text-sm font-semibold uppercase tracking-[0.25em] text-black">
      Software Engineer • Builder
    </p>

    <h1 class="mb-4 text-5xl font-black uppercase leading-none md:text-7xl">
      {hero.name}
    </h1>

    <p class="mb-6 text-2xl font-semibold text-black">
      {hero.title}
    </p>

    <p class="max-w-2xl text-lg text-black/80">
      {hero.description}
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#projects" class="brutalist-btn bg-[#ff6b35] px-6 py-3 text-black">
        View Projects
      </a>

      <a href={hero.github} target="_blank" class="brutalist-btn bg-white px-6 py-3 text-black">
        GitHub
      </a>

      <a href={hero.resume} target="_blank" class="brutalist-btn bg-[#3b82f6] px-6 py-3 text-white">
        Resume
      </a>
    </div>
  </div>
</section>