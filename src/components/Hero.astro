---
import { hero } from "../data/hero";
---

<section id="home" class="section-shell grid min-h-screen items-center gap-10 pt-24 lg:grid-cols-[1.05fr_0.95fr]">
  <div>
    <div class="hero-badge">AI Engineer • Backend Systems • Agentic Workflows</div>
    <h1 class="hero-title">
      Building <span class="accent">Intelligent Software.</span>
    </h1>
    <div class="hero-typing">{hero.title}</div>
    <p class="hero-copy">{hero.description}</p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#projects" class="hero-cta">Explore Work</a>
      <a href={hero.github} target="_blank" class="hero-cta secondary">GitHub</a>
      <a href={hero.resume} target="_blank" class="hero-cta secondary">Resume</a>
    </div>
  </div>

  <div class="hero-visual">
    <!-- Use the developer scene SVG (hero-scene) placed in /public -->
    <img src="/hero.png" alt="Developer working on a futuristic laptop setup" />
    <!-- Floating hero panels removed as requested -->
  </div>
</section>